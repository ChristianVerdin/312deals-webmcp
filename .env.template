# ============================================
# ChiDeals Environment Variables
# Copy to .env and fill in values
# ============================================

# --- REQUIRED ---

# Anthropic Claude API (https://console.anthropic.com)
# Used by: deal_extractor.py, website_scraper.py, extract_deals.py
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API (https://console.cloud.google.com → APIs & Services)
# Used by: Google Maps MCP server, venue enrichment, geocoding
GOOGLE_PLACES_API_KEY=AIza...

# --- OPTIONAL (enhance functionality) ---

# Firecrawl (https://firecrawl.dev → API Keys)
# Used by: Firecrawl MCP server for structured web scraping (500 free/mo)
FIRECRAWL_API_KEY=fc-...

# Brave Search (https://brave.com/search/api/)
# Used by: Brave Search MCP server for venue discovery (2,000 free/mo)
BRAVE_API_KEY=BSA...

# GitHub (https://github.com/settings/tokens)
# Used by: GitHub MCP server for repo management
GITHUB_TOKEN=ghp_...

# --- APP SETTINGS ---

# Database path (default: data/chideals.db)
CHIDEALS_DB_PATH=data/chideals.db

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChiDeals
# Google Maps API key — served via /api/maps-config (not bundled client-side)
# Restrict in GCP Console: HTTP referrer + Maps JavaScript API only
GOOGLE_MAPS_API_KEY=AIza...

# Backend
NODE_ENV=development

# Admin API key (secure random token for protected endpoints)
ADMIN_API_KEY=generate-a-random-hex-here

# --- EMAIL & NEWSLETTERS ---

# AgentMail (newsletter pipeline inbox: 312deals-newsletters@agentmail.to)
# Used by: newsletter ingestion pipeline for subscribing to venue emails and extracting deals
AGENTMAIL_API_KEY=am_us_...

# Resend (https://resend.com — transactional & marketing email sending)
# Domain: 312deals.com (verified via Porkbun DNS — DKIM, SPF, DMARC)
# Used by: welcome emails, submission confirmations, weekly Deal Sheet newsletter
RESEND_API_KEY=re_...
# Svix signing secret for the Resend webhook (Resend Dashboard → Webhooks → your
# endpoint → Signing Secret, starts `whsec_`). Verifies /api/v1/email/webhook.
# Unset = endpoint accepts unverified events (with a one-time warning).
RESEND_WEBHOOK_SECRET=whsec_...
FROM_EMAIL=The Deal Sheet <deals@312deals.com>
UNSUBSCRIBE_SECRET=generate-a-random-secret-here

# --- AFFILIATE NETWORKS ---

# Amazon Associates (https://affiliate-program.amazon.com)
# Used by: src/lib/affiliate.ts (case "amazon"). Format: yourtag-20
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=

# Awin publisher ID (https://ui.awin.com — Account → Profile)
# Shared across ALL Awin advertisers (Booking.com, Viator, Architecture Tour, etc.)
NEXT_PUBLIC_AWIN_PUBLISHER_ID=2872897

# Booking.com North America via Awin (MID 6776)
# Five regional variants exist; we promote NA. LATAM=18119, Brazil=18120, APAC=18117, AU=18118.
NEXT_PUBLIC_BOOKING_AWIN_MID=6776

# --- FUTURE PHASES (not needed for MVP) ---

# Stripe / Featured listings (B2B). Set the payment link to switch the /featured
# CTA from "Get in touch" (email) to a one-click Stripe checkout.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_FEATURED_LISTING_STRIPE_LINK=
